{
  "name": "cti-defense",
  "version": "1.0.0",
  "description": "He thong phong thu an ninh mang tu hanh tu tinh bao CTI va dong goi ky nang tac tu (Autonomous CTI Agentic Defense)",
  "main": "bin/cli.js",
  "bin": {
    "cti-defense": "bin/cli.js",
    "cti": "bin/cli.js"
  },
  "files": [
    "bin",
    "cti_core",
    "!cti_core/**/*.exe",
    "!cti_core/**/*.msi",
    "!cti_core/**/*.dll",
    "!cti_core/**/*.sys",
    "!cti_core/**/suricata_bin",
    "!cti_core/**/suricata_windivert_bin",
    "!cti_core/*full_corpus*",
    "!cti_core/scratch",
    "apply_to_project.py",
    "requirements.txt",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "start": "node ./bin/cli.js",
    "scan": "node ./bin/cli.js scan",
    "stop": "node ./bin/cli.js stop",
    "status": "node ./bin/cli.js status"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khang1233/DoAnChuyenNganh.git"
  },
  "keywords": [
    "cti",
    "cyber-threat-intelligence",
    "agentic-defense",
    "ai-security",
    "waf",
    "autonomous-agent",
    "mitre-attack"
  ],
  "author": "Khang",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  }
}
